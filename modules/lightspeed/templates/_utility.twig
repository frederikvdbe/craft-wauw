{% import '_includes/forms.twig' as forms %}

{% set lastRun = runs|first %}
{% set problems = lastRun ? lastRun.steps|filter(s => s.status in ['failed', 'stopped']) : [] %}
{% if problems|length %}
    <div class="error has-icon">
        <span class="icon" aria-hidden="true"></span>
        <div>
            <strong>The last sync ({{ lastRun.startedAt|datetime('short') }}) did not finish.</strong>
            <ul>
                {% for step in problems %}
                    <li>{{ step.label }}: {{ step.status }}{% if step.error %} – {{ step.error }}{% endif %}</li>
                {% endfor %}
            </ul>
            <p>Retry or release the steps in <a href="{{ cpUrl('utilities/queue-manager') }}">Queue Manager</a>, or start a new sync.</p>
        </div>
    </div>
{% endif %}

{% if isQueued %}
    <p class="notice has-icon">
        <span class="icon" aria-hidden="true"></span>
        <span>A sync is in the queue. See <a href="{{ cpUrl('utilities/queue-manager') }}">Queue Manager</a>.</span>
    </p>
{% endif %}

<form id="lightspeed-sync" method="post" accept-charset="UTF-8">
    {{ actionInput('lightspeed/sync/start') }}
    {{ csrfInput() }}

    {% set extractInput %}
        {% if emptyNames|length %}
            {{ forms.checkbox({
                id: 'extract-with-data',
                label: "Only lists with data (#{emptyNames|length} empty)",
                checked: true,
            }) }}
            <hr>
        {% endif %}
        {{ forms.checkboxSelect({
            id: 'extract-lists',
            name: 'extract',
            options: extractOptions,
            showAllOption: true,
        }) }}
    {% endset %}

    {{ forms.field({
        label: '1. Extract',
        instructions: 'Download from the Lightspeed API (read-only) to `storage/lightspeed/api/`. Full extract ≈ 10k requests, a few hours (rate limit).',
    }, extractInput) }}

    {{ forms.checkboxSelectField({
        label: '2. Import',
        instructions: 'From the export into Craft, in this order. Safe to run again; existing orders are skipped.',
        name: 'import',
        options: importOptions,
        showAllOption: true,
        values: '*',
    }) }}

    {{ forms.lightswitchField({
        label: 'Sample only',
        instructions: 'A small, fixed test set; email addresses made invalid. Extract: per-item lists (images, order lines, …) only for the sample items. Off = everything.',
        name: 'sample',
        on: true,
    }) }}

    <div class="buttons">
        <button type="submit" class="btn submit"{% if isQueued %} disabled{% endif %}>Start sync</button>
    </div>
</form>

{% set statusColors = {waiting: 'light', running: 'blue', done: 'green', failed: 'red', stopped: 'orange'} %}
{% if runs|length %}
    <hr>
    <h2>Last syncs</h2>
    {% for run in runs %}
        <h3>
            <span class="status {{ statusColors[run.status] }}" aria-hidden="true"></span>
            {{ run.startedAt|datetime('short') }} · {{ run.sample ? 'Sample' : 'Full' }} · {{ run.status }}
        </h3>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>Step</th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Time</th>
                    <th>Warnings / error</th>
                </tr>
            </thead>
            <tbody>
                {% for step in run.steps %}
                    <tr>
                        <td>{{ step.label }}</td>
                        <td><span class="status {{ statusColors[step.status] }}" aria-hidden="true"></span>{{ step.status }}</td>
                        <td>{{ step.items is not null ? "#{step.done|number} / #{step.items|number}" : '–' }}</td>
                        <td>
                            {% if step.startedAt %}
                                {{ step.startedAt|time('short') }}
                                {% if step.finishedAt %}({{ (step.finishedAt - step.startedAt)|duration }}){% endif %}
                            {% else %}
                                –
                            {% endif %}
                        </td>
                        <td>
                            {% if step.error %}<p class="error">{{ step.error }}</p>{% endif %}
                            {% if step.warningCount %}
                                <details>
                                    <summary>{{ step.warningCount|number }} {{ step.warningCount == 1 ? 'warning' : 'warnings' }}</summary>
                                    <ul>
                                        {% for warning in step.warnings %}<li>{{ warning }}</li>{% endfor %}
                                    </ul>
                                    {% if step.warningCount > step.warnings|length %}<p class="light">First {{ step.warnings|length }} shown; all in the logs.</p>{% endif %}
                                </details>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endfor %}
{% endif %}

{% js %}
    (() => {
        const withData = document.getElementById('extract-with-data');
        if (!withData) {
            return;
        }
        const lists = document.getElementById('extract-lists');
        const all = lists.querySelector('input.all');
        const emptyNames = {{ emptyNames|json_encode|raw }};
        const empty = [...lists.querySelectorAll('input:not(.all)')].filter((input) => emptyNames.includes(input.value));

        const apply = () => {
            if (withData.checked && all.checked) {
                $(all).prop('checked', false).trigger('change');
            }
            empty.forEach((input) => {
                input.disabled = withData.checked;
                input.closest('.checkbox-select-item').style.opacity = withData.checked ? .4 : '';
                if (withData.checked) {
                    input.checked = false;
                }
            });
        };

        withData.addEventListener('change', apply);
        $(all).on('change', () => {
            if (all.checked && withData.checked) {
                withData.checked = false;
                empty.forEach((input) => input.closest('.checkbox-select-item').style.opacity = '');
            }
        });
        apply();
    })();

    document.getElementById('lightspeed-sync').addEventListener('submit', (event) => {
        const form = event.target;
        const checked = (name) => [...form.querySelectorAll(`input[name="${name}[]"]:checked, input[name="${name}"][value="*"]:checked`)];
        const fullExtract = checked('extract').some((input) => input.value === '*');
        const fullImport = checked('import').length && !form.querySelector('input[name="sample"]').value;
        const warnings = [
            fullExtract && 'Full extract of the live shop: a few hours.',
            fullImport && 'Full import: everything, real email addresses.',
        ].filter(Boolean);
        if (warnings.length && !confirm(warnings.join('\n') + '\n\nContinue?')) {
            event.preventDefault();
        }
    });
{% endjs %}
