{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{# `users/send-password-reset-email`'s JSON response always carries Craft's
   own (English) success message -- override it so it matches the rest of
   this Dutch-language UI. #}
{% set successMessage = "We hebben je een e-mail gestuurd om je wachtwoord opnieuw in te stellen."|t %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% extends "_base/layout" %}

{% set pageClass = "auth" %}

{% block content %}
    <section class="b-auth container" x-data="forgotPasswordForm({{ { successMessage: successMessage }|json_encode }})">
        {% include "_components/title" with { title: "Wachtwoord vergeten"|t, tag: "h1" } only %}

        {% embed "_components/fields/form" with { id: "forgot-password-form" } %}
            {% block fields %}
                {{ actionInput("users/send-password-reset-email") }}

                {# See login.twig -- same native-attribute name. #}
                {% include "_components/fields/text" with {
                    id: "loginName",
                    namePrefix: "",
                    label: "E-mailadres"|t,
                    type: "email",
                    required: true,
                    autocomplete: "username",
                } only %}

                {% include "_components/button" with {
                    label: "Verstuur resetlink"|t,
                    attributes: {
                        type: "submit",
                        ":class": "{ 'is-loading': loading }",
                        ":disabled": "loading",
                    },
                } only %}
            {% endblock %}
        {% endembed %}

        <div class="b-auth-links">
            <a href="{{ url(craft.app.config.general.loginPath) }}" class="b-auth-link">
                {{ "Terug naar inloggen"|t }}
            </a>
        </div>
    </section>
{% endblock %}
