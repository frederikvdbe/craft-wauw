{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set code = code|default("") %}
{# Named `uid`, not `id` -- the form embed below sets its own `id` in scope,
   which would otherwise shadow the URL's `id` param inside `block fields`. #}
{% set uid = id|default("") %}

{# `users/set-password`'s JSON response never includes a `message` on
   success (unlike every other action we post to) -- give setPasswordForm() one
   to fall back to instead of submitForm()'s generic error-flavored default. #}
{% set successMessage = "Je wachtwoord is ingesteld."|t %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% extends "_base/layout" %}

{% set pageClass = "auth" %}

{% block content %}
    <section class="b-auth container" x-data="setPasswordForm({{ { successMessage: successMessage }|json_encode }})">
        {% include "_components/title" with { title: "Stel je wachtwoord in"|t, tag: "h1" } only %}

        {% embed "_components/fields/form" with { id: "set-password-form" } %}
            {% block fields %}
                {{ actionInput("users/set-password") }}
                {{ hiddenInput("code", code) }}
                {{ hiddenInput("id", uid) }}

                {% include "_components/fields/text" with {
                    id: "newPassword",
                    namePrefix: "",
                    label: "Wachtwoord"|t,
                    type: "password",
                    required: true,
                    autocomplete: "new-password",
                } only %}

                {% include "_components/button" with {
                    label: "Wachtwoord instellen"|t,
                    attributes: {
                        type: "submit",
                        ":class": "{ 'is-loading': loading }",
                        ":disabled": "loading",
                    },
                } only %}
            {% endblock %}
        {% endembed %}
    </section>
{% endblock %}
