{% extends "_base/layout" %}

{% set pageClass = "checkout" %}

{% set cart = craft.commerce.carts.cart %}
{% set shippingAddress = cart.shippingAddress %}
{% set mollieGateway = craft.commerce.gateways.getGatewayByHandle('mollie') %}

{% set shippingOptions = [] %}
{% for handle, option in cart.availableShippingMethodOptions %}
    {% set shippingOptions = shippingOptions|merge([{
        title: option.name,
        value: option.handle,
        tooltip: option.shippingMethod.tooltip ? option.shippingMethod.tooltip|t : "",
        description: option.shippingMethod.description ? option.shippingMethod.description|t : "",
        price: option.price,
    }]) %}
{% endfor %}

{% set paymentOptions = [
    { title: "Bancontact", value: "bancontact", image: "bancontact" },
    { title: "Ideal / Wero", value: "ideal", image: "wero" },
    { title: "Creditcard", value: "creditcard", image: "creditcard", price: 108 },
    { title: "Wire transfer", value: "wire", image: "banktransfer" },
] %}

{% set initialData = {
    "shippingAddress-firstName": shippingAddress.firstName ?? "",
    "shippingAddress-lastName": shippingAddress.lastName ?? "",
    "shippingAddress-email": cart.email ?? "",
    "shippingAddress-bus": shippingAddress.addressLine2 ?? "",
    "shippingAddress-locality": shippingAddress.locality ?? "",
    "shippingAddress-postalCode": shippingAddress.postalCode ?? "",
    "shippingAddress-administrativeArea": shippingAddress.administrativeArea ?? "",
    "shippingAddress-phone": shippingAddress.mobileField ?? "",
} %}

{% block content %}
    <section class="b-checkout container" x-data="checkout({{ initialData|json_encode }})">
        <div class="b-checkout-content" :class="{ 'is-loading': loading }">
            {% embed "_components/fields/form" with { id: "checkout-form", showMessages: false } %}
                {% block fields %}
                    {{ actionInput('commerce/cart/update-cart') }}
                    {{ redirectInput(siteUrl) }}
                    {{ hiddenInput('cancelUrl', url('checkout')|hash) }}
                    {{ hiddenInput('gatewayId', mollieGateway.id) }}

                    <div class="b-checkout-column b-checkout-column--address">
                        {% include "_components/checkoutSectionTitle" with { index: 1, title: "Shipping address"|t } only %}

                        {% include "_components/fields/address" with {
                            fieldHandle: "shippingAddress",
                            namePrefix: "shippingAddress",
                            address: shippingAddress,
                        } only %}

                        {% include "_components/checkoutSectionTitle" with { index: 2, title: "Shipping options"|t } only %}

                        {% include "_components/fields/radioGroup" with {
                            id: "shipping-options",
                            name: "shippingMethodHandle",
                            value: cart.shippingMethodHandle ?? "",
                            options: shippingOptions,
                            onChange: "updateShippingMethod(value)",
                        } only %}
                    </div>

                    <div class="b-checkout-column b-checkout-column--payment">
                        {% include "_components/checkoutSectionTitle" with { index: 2, title: "Payment methods"|t } only %}

                        {% include "_components/fields/radioGroup" with {
                            id: "payment-methods",
                            name: "paymentForm[#{mollieGateway.handle}][paymentMethod]",
                            value: "creditcard",
                            options: paymentOptions,
                            onChange: "updatePaymentMethod(value)",
                        } only %}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="b-checkout-column b-checkout-column--summary">
                {% include "_components/cartOverview" with {
                    showCheckoutButton: false,
                    showCosts: true,
                } only %}

                {% include "_components/button" with {
                    label: "Place order"|t,
                    class: "safe",
                    attributes: {
                        type: "submit",
                        form: "checkout-form",
                        ":class": "{ 'is-loading': loading }",
                        ":disabled": "loading",
                    },
                } only %}
    
                <div class="b-checkout-opt-ins">
                    {% include "_components/fields/checkbox" with {
                        id: "vipSignup",
                        label: "Yess! add me to the <strong>VIP MEMBER LIST</strong> Receive our new arrivals 1 day before they go online!"|t,
                        attributes: { form: "checkout-form" },
                    } only %}

                    {% include "_components/fields/checkbox" with {
                        id: "termsAccepted",
                        label: "I acknowledge that I have to pay for this item and agree with the <a href='#'>general terms and conditions</a>"|t,
                        required: true,
                        attributes: { form: "checkout-form" },
                    } only %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
