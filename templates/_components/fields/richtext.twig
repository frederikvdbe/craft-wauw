{% extends "_components/fields/field" %}

{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set id = id|default("") %}

{% set namePrefix = namePrefix is defined ? namePrefix : "fields" %}
{% set name = name|default(id and namePrefix ? "#{namePrefix}[#{id}]" : id) %}
{% set model = model is defined ? model : (id ? "form['#{id}']" : "") %}

{% set label = label|default("") %}
{% set value = value|default("") %}
{% set required = required|default(false) %}
{% set plain = plain|default(false) %}
{% set class = (class|default("")) ~ (plain ? " -plain" : "") %}
{% set attributes = attributes|default({}) %}
{% set maxlength = maxlength|default(null) %}

{% set fieldType = "richtext" %}
{% set wrapperAttributes = {
    "x-data": "richText('#{plain ? 'plain' : 'full'}', #{maxlength is null ? 'null' : maxlength})",
} %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% set baseAttributes = { id: id, name: name } %}

{% if model %}
    {% set baseAttributes = baseAttributes|merge({ "x-model": model }) %}
{% endif %}

{% block input %}
    {% set baseAttributes = validate ? baseAttributes|merge({ "@blur": validate }) : baseAttributes %}

    <textarea
        class="c-field-richtext-source"
        x-ref="source"
        {{ attr(baseAttributes|merge(attributes)) }}
    >
        {{ value }}
    </textarea>

    {% if maxlength %}
        <span class="c-field-richtext-count" x-text="`${charCount}/${maxlength}`"></span>
    {% endif %}
{% endblock %}
