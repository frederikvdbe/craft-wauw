{% extends "_components/fields/field" %}

{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set id = id|default("") %}

{# See text.twig for `namePrefix`/`model` -- same convention, same opt-out. #}
{% set namePrefix = namePrefix is defined ? namePrefix : "fields" %}
{% set name = name|default(id and namePrefix ? "#{namePrefix}[#{id}]" : id) %}
{% set model = model is defined ? model : (id ? "form['#{id}']" : "") %}

{% set label = label|default("") %}
{% set value = value|default("") %}
{% set placeholder = placeholder|default("Selecteer een datum"|t) %}
{% set required = required|default(false) %}
{% set min = min|default("") %}
{% set max = max|default("") %}
{% set class = class|default("") %}
{% set attributes = attributes|default({}) %}

{% set fieldType = "date" %}
{% set wrapperAttributes = {
    "x-data": "datepicker(#{value|json_encode}, #{min|json_encode}, #{max|json_encode})",
    "@click.outside": "closePicker()",
} %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% set hiddenAttributes = { type: "hidden", name: name, required: required } %}

{% if model %}
    {% set hiddenAttributes = hiddenAttributes|merge({ "x-model": model }) %}
{% else %}
    {% set hiddenAttributes = hiddenAttributes|merge({ ":value": "value" }) %}
{% endif %}

{% block input %}
    <button
        type="button"
        id="{{ id }}"
        class="c-field-date-trigger"
        aria-haspopup="dialog"
        :aria-expanded="open ? 'true' : 'false'"
        x-ref="trigger"
        x-text="displayValue || {{ placeholder|json_encode }}"
        @click="open ? closePicker() : openPicker()"
        {{ attr(attributes) }}
    ></button>

    <input {{ attr(hiddenAttributes) }}>

    <div
        x-ref="panel"
        x-show="open"
        x-cloak
        class="c-field-date-panel"
        role="dialog"
        @keydown.escape="closePicker(); $refs.trigger.focus()"
    >
        <calendar-date
            :value="value"
            {% if min %}min="{{ min }}"{% endif %}
            {% if max %}max="{{ max }}"{% endif %}
            @change="onChange($event)"
        >
            <calendar-month></calendar-month>
        </calendar-date>
    </div>
{% endblock %}
