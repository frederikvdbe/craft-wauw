{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set fieldHandle = fieldHandle|default("") %}
{% set address = address ?? null %}
{% set addressKey = address.id ?? "new1" %}
{% set namePrefix = namePrefix is defined ? namePrefix : "fields[#{fieldHandle}][#{addressKey}]" %}
{% set idPrefix = idPrefix|default(fieldHandle) %}

{% set label = label|default("") %}
{% set class = class|default("") %}
{% set defaultCountryCode = defaultCountryCode|default("BE") %}
{% set countryCode = address.countryCode ?? defaultCountryCode %}

{% set addressTitle = addressTitle|default("") %}
{% set addressTitle = addressTitle != "" ? addressTitle : (label != "" ? label : "Adres"|t) %}

{% set addressFormat = craft.app.addresses.getAddressFormatRepository().get(countryCode) %}
{% set usedFields = addressFormat.getUsedFields() %}
{% set requiredFields = addressFormat.getRequiredFields() %}

{% set countryOptions = [] %}
{% set countryLabel = "" %}

{% for code, name in craft.app.addresses.getCountryList() %}
    {% set countryOptions = countryOptions|merge([{ value: code, label: name }]) %}

    {% if code == countryCode %}
        {% set countryLabel = name %}
    {% endif %}
{% endfor %}

{% set customerTypeOptions = [
    { value: "private", label: "Private"|t },
    { value: "company", label: "Company"|t },
] %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<fieldset class="c-field-address {{ class }}" x-data="address({{ idPrefix|json_encode }}, {{ (address.addressLine1 ?? "")|json_encode }})">
    {% if label %}
        <legend class="c-field-address-label">{{ label }}</legend>
    {% endif %}

    {{ hiddenInput("#{namePrefix}[title]", addressTitle) }}

    <div class="c-field-address-row">
        <div class="c-field-address-row-primary">
            {% include "_components/fields/text" with {
                id: "#{idPrefix}-firstName",
                name: "#{namePrefix}[firstName]",
                label: "First name"|t,
                autocomplete: "given-name",
            } only %}
        </div>

        <div class="c-field-address-row-primary">
            {% include "_components/fields/text" with {
                id: "#{idPrefix}-lastName",
                name: "#{namePrefix}[lastName]",
                label: "Last name"|t,
                autocomplete: "family-name",
            } only %}
        </div>
    </div>

    <div class="c-field-address-row">
        <div class="c-field-address-row-primary">
            {% include "_components/fields/text" with {
                id: "#{idPrefix}-email",
                name: "email",
                type: "email",
                label: "E-mail"|t,
                autocomplete: "email",
            } only %}
        </div>

        <div class="c-field-address-row-secondary">
            {% include "_components/fields/autocomplete" with {
                id: "#{idPrefix}-customerType",
                name: "customerType",
                label: "Customer type"|t,
                options: customerTypeOptions,
                value: customerTypeOptions[0].value,
                valueLabel: customerTypeOptions[0].label,
            } only %}
        </div>
    </div>

    <div class="c-field-address-row">
        <div class="c-field-address-row-primary">
            {% embed "_components/fields/field" with {
                fieldType: "text",
                label: "Street name"|t,
                labelFor: "#{idPrefix}-streetName",
            } %}
                {% block input %}
                    <input
                        type="text"
                        id="{{ idPrefix }}-streetName"
                        class="c-field-input"
                        autocomplete="address-line1"
                        x-model="streetName"
                        {{ "addressLine1" in requiredFields ? "required" : "" }}
                    >
                {% endblock %}
            {% endembed %}
        </div>

        <div class="c-field-address-row-secondary">
            {% embed "_components/fields/field" with {
                fieldType: "text",
                label: "Number"|t,
                labelFor: "#{idPrefix}-number",
            } %}
                {% block input %}
                    <input
                        type="text"
                        id="{{ idPrefix }}-number"
                        class="c-field-input"
                        x-model="number"
                    >
                {% endblock %}
            {% endembed %}
        </div>

        <div class="c-field-address-row-secondary">
            {% include "_components/fields/text" with {
                id: "#{idPrefix}-bus",
                name: "#{namePrefix}[addressLine2]",
                label: "Bus"|t,
                autocomplete: "address-line2",
            } only %}
        </div>
    </div>

    <input type="hidden" name="{{ namePrefix }}[addressLine1]" :value="addressLine1">

    {% if "locality" in usedFields or "postalCode" in usedFields %}
        <div class="c-field-address-row">
            {% if "locality" in usedFields %}
                <div class="c-field-address-row-primary">
                    {% include "_components/fields/text" with {
                        id: "#{idPrefix}-locality",
                        name: "#{namePrefix}[locality]",
                        label: "City"|t,
                        required: "locality" in requiredFields,
                        autocomplete: "address-level2",
                    } only %}
                </div>
            {% endif %}

            {% if "postalCode" in usedFields %}
                <div class="c-field-address-row-secondary">
                    {% include "_components/fields/text" with {
                        id: "#{idPrefix}-postalCode",
                        name: "#{namePrefix}[postalCode]",
                        label: "Zip / Postal code"|t,
                        required: "postalCode" in requiredFields,
                        autocomplete: "postal-code",
                    } only %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if "administrativeArea" in usedFields %}
        {% include "_components/fields/text" with {
            id: "#{idPrefix}-administrativeArea",
            name: "#{namePrefix}[administrativeArea]",
            label: craft.app.addresses.getFieldLabel("administrativeArea", countryCode),
            required: "administrativeArea" in requiredFields,
            autocomplete: "address-level1",
        } only %}
    {% endif %}

    <div class="c-field-address-row">
        <div class="c-field-address-row-primary">
            {% include "_components/fields/autocomplete" with {
                id: "#{idPrefix}-countryCode",
                name: "#{namePrefix}[countryCode]",
                label: "Country"|t,
                options: countryOptions,
                value: countryCode,
                valueLabel: countryLabel,
                required: true,
            } only %}
        </div>

        <div class="c-field-address-row-secondary">
            {% include "_components/fields/text" with {
                id: "#{idPrefix}-phone",
                name: "#{namePrefix}[fields][mobileField]",
                type: "tel",
                label: "Phone nr."|t,
                autocomplete: "tel",
            } only %}
        </div>
    </div>
</fieldset>
