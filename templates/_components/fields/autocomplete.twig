{% extends "_components/fields/field" %}

{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set id = id|default("") %}

{# See text.twig for `namePrefix` -- same convention, same opt-out. #}
{% set namePrefix = namePrefix is defined ? namePrefix : "fields" %}
{% set name = name|default(id and namePrefix ? "#{namePrefix}[#{id}]" : id) %}

{% set label = label|default("") %}
{% set options = options|default([]) %}
{% set value = value|default("") %}
{% set valueLabel = valueLabel|default("") %}
{% set placeholder = placeholder|default("") %}
{% set required = required|default(false) %}
{% set class = class|default("") %}
{% set teleportTarget = teleportTarget|default("body") %}

{% set fieldType = "autocomplete" %}
{% set wrapperAttributes = {
    "x-data": "autocomplete(#{id|json_encode}, #{options|json_encode}, #{value|json_encode}, #{valueLabel|json_encode})",
} %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% block input %}
    <div class="c-field-autocomplete-control">
        <input
            type="text"
            id="{{ id }}"
            class="c-field-input"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="{{ id }}-list"
            :aria-expanded="open ? 'true' : 'false'"
            placeholder="{{ placeholder }}"
            x-ref="input"
            x-model="query"
            @focus="onFocus()"
            @input="onInput()"
            @keydown.arrow-down.prevent="moveActive(1)"
            @keydown.arrow-up.prevent="moveActive(-1)"
            @keydown.enter.prevent="selectActive()"
            @keydown.escape="closeList()"
            @blur="onBlur(); {{ validate }}"
        >

        {% include "_components/icon" with { icon: "chevron-down" } only %}
    </div>

    <input type="hidden" name="{{ name }}" {{ required ? "required" : "" }} :value="value">

    <template x-teleport="{{ teleportTarget }}">
        <ul
            id="{{ id }}-list"
            x-ref="list"
            x-show="open"
            x-cloak
            class="c-field-autocomplete-list"
            role="listbox"
        >
            <template x-for="(option, index) in filteredOptions" :key="option.value">
                <li
                    role="option"
                    class="c-field-autocomplete-option"
                    :class="{ 'is-active': index === activeIndex }"
                    :aria-selected="index === activeIndex"
                    @mousedown.prevent
                    @click="select(option)"
                    x-text="option.label"
                ></li>
            </template>

            <li x-show="!filteredOptions.length" class="c-field-autocomplete-empty">{{ "Geen resultaten"|t }}</li>
        </ul>
    </template>
{% endblock %}
