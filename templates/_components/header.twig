{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set cartModalId = "cart-modal" %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<header class="c-header container">
    <div class="c-header-content">
        <a href="{{ siteUrl }}" class="c-header-logo" aria-label="{{ "Go to the homepage"|t }}">
            {% include "_components/icon" with { icon: "wauw-wordmark-slogan" } only %}
        </a>

        {% include "_components/primaryNavigation" %}

        <div class="c-header-actions">
            {% include "_components/search" %}

            {% include "_components/localization" %}

            <div class="c-header-important-actions">
                <a class="c-header-account" href="{{ currentUser ? url('member-zone') : url('login') }}">
                    {% include "_components/icon" with { icon: "account" } only %}
                </a>

                <button
                    type="button"
                    class="c-header-cart"
                    @click="openModal('{{ cartModalId }}')"
                >
                    {% include "_components/icon" with { icon: "cart" } only %}

                    <div
                        class="c-header-cart-badge"
                        x-text="$store.cart.totalQuantity > 0 ? $store.cart.totalQuantity : ''"
                    ></div>
                </button>
            </div>
        </div>

        {% include "_components/modals/cart" with { id: cartModalId } only %}
    </div>
</header>