{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set variant = variant|default(null) %}
{% set priceOnRequest = variant.priceOnRequestField|default(false) %}
{% set shippingCalculatorModalId = "shipping-calculator-modal-#{variant.id|default(random())}" %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<div class="b-product-actions">
    {% if variant and not priceOnRequest %}
        {% include "_components/addToCartButton" with { variant } only %}
        {% include "_components/removeFromCartButton" with { variant } only %}
    {% endif %}

    {% include "_components/button" with {
        label: "shipping calculator"|t,
        class: "tertiary",
        attributes: {
            type: "button",
            "@click": "openModal('#{shippingCalculatorModalId}')",
        },
    } only %}
</div>
