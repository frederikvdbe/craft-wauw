{% cache %}
    
{% set legalNavigation = footer.legalNavigationField.eagerly().all() %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<nav class="c-legal-navigation">
    <ul class="c-legal-navigation-lists">
        {% for link in legalNavigation %}
            <li class="c-legal-navigation-list-item">
                {% include "_components/navigationLink" with { link } only %}
            </li>
        {% endfor %}
    </ul>
</nav>

{% endcache %}