{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set class = class|default("") %}
{% set icon = icon|default("") %}
{% set attributes = attributes|default({}) %}

{% set svgAttributes = {
    class: "c-icon " ~ class ~ " " ~ icon,
}|merge(attributes) %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% if icon %}
    {{ svg("@webroot/icons/#{icon}.svg")|attr(svgAttributes) }}
{% endif %}