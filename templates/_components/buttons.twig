{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set buttons = buttons|default([]) %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% if buttons|length > 1 %}
    <ul class="c-buttons">
        {% for button in buttons %}
            <li class="c-buttons-item">
                {% include "_components/button" with { button } only %}
            </li>
        {% endfor %}
    </ul>
{% elseif buttons|length %}
    {% include "_components/button" with { button: buttons[0] } only %}
{% endif %}