{% set brand = product.brandField.one() %}
{% set categories = product.productCategoriesField.all() %}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        @page {
            margin: 28px 36px;
        }

        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            font-size: 11px;
            color: #1a1a1a;
        }

        .header {
            overflow: hidden;
            border-bottom: 2px solid #1a1a1a;
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        .header .brand-image {
            float: right;
            max-width: 120px;
            max-height: 48px;
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 9px;
            color: #666;
            margin: 0 0 4px;
        }

        h1 {
            font-size: 20px;
            margin: 0;
        }

        .images {
            overflow: hidden;
            margin-top: 16px;
        }

        .images img {
            float: left;
            width: 48%;
            margin: 0 4% 16px 0;
            border: 1px solid #ddd;
        }

        .images img:nth-child(2n) {
            margin-right: 0;
        }

        table.specs {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
        }

        table.specs td {
            padding: 4px 0;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }

        table.specs td.label {
            width: 35%;
            color: #666;
        }

        .price {
            font-size: 16px;
            font-weight: bold;
            margin: 10px 0;
        }

        .description {
            margin: 10px 0;
            line-height: 1.5;
        }

        .rich-text img {
            max-width: 100%;
        }

        .links a {
            display: block;
            color: #1a1a1a;
            margin-bottom: 4px;
        }

        .footer {
            margin-top: 24px;
            padding-top: 8px;
            border-top: 1px solid #ddd;
            font-size: 9px;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="header">
        {% if brandImageSrc %}
            <img class="brand-image" src="{{ brandImageSrc }}" alt="{{ brand.title }}">
        {% endif %}
        <p class="eyebrow">{{ brand ? brand.title : 'Specification sheet' }}</p>
        <h1>{{ product.fullTitleField ?: product.title }}</h1>
        <div style="clear: both;"></div>
    </div>

    <div class="details">
        {% if product.priceOnRequestField %}
            <p class="price">Price on request</p>
        {% elseif variant and variant.price %}
            <p class="price">{{ variant.price|commerceCurrency }}</p>
        {% endif %}

        {% if product.shortDescriptionField %}
            <p class="description">{{ product.shortDescriptionField }}</p>
        {% endif %}

        <table class="specs">
            {% if brand %}
                <tr><td class="label">Brand</td><td>{{ brand.title }}</td></tr>
            {% endif %}
            {% if categories|length %}
                <tr><td class="label">Category</td><td>{{ categories|map(c => c.title)|join(', ') }}</td></tr>
            {% endif %}
            {% if variant and variant.sku %}
                <tr><td class="label">SKU</td><td>{{ variant.sku }}</td></tr>
            {% endif %}
            {% if variant and variant.eanField %}
                <tr><td class="label">EAN</td><td>{{ variant.eanField }}</td></tr>
            {% endif %}
            {% if variant and (variant.length or variant.width or variant.height) %}
                <tr><td class="label">Dimensions (cm)</td><td>{{ [variant.length, variant.width, variant.height]|filter(v => v)|join(' x ') }}</td></tr>
            {% endif %}
            {% if variant and variant.weight %}
                <tr><td class="label">Weight (kg)</td><td>{{ variant.weight }}</td></tr>
            {% endif %}
        </table>

        {% if product.videoField or product.viewerUrlField %}
            <div class="links">
                {% if product.videoField %}<a href="{{ product.videoField }}">Video: {{ product.videoField }}</a>{% endif %}
                {% if product.viewerUrlField %}<a href="{{ product.viewerUrlField }}">3D / interactive viewer: {{ product.viewerUrlField }}</a>{% endif %}
            </div>
        {% endif %}
    </div>

    {% if product.richTextField %}
        <div class="rich-text">{{ product.richTextField }}</div>
    {% endif %}

    {% if images %}
        <div class="images">
            {% for src in images %}
                <img src="{{ src }}" alt="{{ product.fullTitleField ?: product.title }}">
            {% endfor %}
            <div style="clear: both;"></div>
        </div>
    {% endif %}

    <div class="footer">
        {{ product.fullTitleField ?: product.title }} &middot; generated {{ now|date('Y-m-d') }}
    </div>
</body>
</html>
