{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set text = entry.richTextField|default("") %}
{% set variant = entry.defaultVariant %}

{% set dimensions = [
    { label: "Length"|t, value: variant.length|default(null), unit: "cm", altValue: variant.length|default(null)|inches, altUnit: "in" },
    { label: "Width"|t, value: variant.width|default(null), unit: "cm", altValue: variant.width|default(null)|inches, altUnit: "in" },
    { label: "Height"|t, value: variant.height|default(null), unit: "cm", altValue: variant.height|default(null)|inches, altUnit: "in" },
    { label: "Weight"|t, value: variant.weight|default(null), unit: "kg", altValue: variant.weight|default(null)|pounds, altUnit: "lb" },
]|filter(dimension => dimension.value) %}

{# TODO: no materials field yet #}
{% set materials = [] %}

{% set specSheetUrl = specSheetUrl(entry) %}

{% set askDavyMonaModalId = "ask-davy-mona-modal" %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<section id="product-specifications" class="b-product-specifications container">
    <div class="b-product-specifications-content">
        <div class="b-product-specifications-left">
            {% include "_components/title" with { title: "Product specifications"|t, tag: "h2" } only %}

            {% include "_components/richText" with { text } only %}

            {% include "_components/productActions" with { variant } only %}

            <div class="b-product-specifications-actions">
                {% include "_components/ctaCard" with {
                    icon: "staff-circle",
                    title: "Ask Davy & Mona"|t,
                    description: "Get personal advice from our Founders on this piece or any other."|t,
                    linkLabel: "Contact us"|t,
                    modalId: askDavyMonaModalId,
                } only %}

                {% include "_components/ctaCard" with {
                    icon: "calendar-circle",
                    title: "Book a private viewing"|t,
                    description: "Visit our gallery in Kuurne by appointment."|t,
                    linkLabel: "Book now"|t,
                    linkUrl: "#",
                } only %}
            </div>
        </div>

        <div class="b-product-specifications-right">
            <h3 class="b-product-specifications-dimensions-title">{{ "Dimensions"|t }}</h3>

            <dl class="b-product-specifications-dimensions">
                {% for dimension in dimensions %}
                    <div class="b-product-specifications-dimension">
                        <dt>{{ dimension.label }}</dt>
                        <dd>{{ dimension.value }} {{ dimension.unit }} / {{ dimension.altValue }} {{ dimension.altUnit }}</dd>
                    </div>
                {% endfor %}
            </dl>

            <p class="b-product-specifications-materials">
                <span class="b-product-specifications-materials-label">{{ "Materials"|t }}</span>

                {% if materials %}
                    <span class="b-product-specifications-materials-list">{{ materials|join(", ") }}</span>
                {% endif %}
            </p>

            {% if specSheetUrl %}
                <a class="b-product-specifications-download" href="{{ specSheetUrl }}" label="{{ "Download specification sheet"|t }}" download>
                    {% include "_components/icon" with { icon: "pdf-file" } only %}

                    {% include "_components/text" with { text: "Download\n specification sheet"|t|nl2br } only %}
                </a>
            {% endif %}
        </div>
    </div>

    {% include "_components/modals/askDavyMona" with { id: askDavyMonaModalId } only %}
</section>
